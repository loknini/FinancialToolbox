# Copy to .env and generate a random key of at least 32 characters.
FT_ENVIRONMENT=development
FT_DATABASE_URL=sqlite:///./var/toolbox.db
FT_AUTH_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters
FT_PUBLIC_BASE_URL=http://127.0.0.1:8000
FT_STORAGE_ROOT=./var/storage
FT_STORAGE_BACKEND=local
# Development login is separate from real WeChat login; never enable in production.
FT_ENABLE_DEV_LOGIN=false
FT_WECHAT_APP_ID=
FT_WECHAT_APP_SECRET=
FT_ACCESS_TOKEN_SECONDS=900
FT_REFRESH_TOKEN_SECONDS=2592000
FT_UPLOAD_SESSION_SECONDS=86400
FT_SIGNED_URL_SECONDS=300
FT_UPLOAD_PART_BYTES=8388608
FT_JOB_LEASE_SECONDS=120

# Stage 2: local remains the default. Set cos after provisioning a private bucket.
FT_COS_BUCKET=
FT_COS_REGION=ap-guangzhou
FT_COS_SECRET_ID=
FT_COS_SECRET_KEY=
FT_COS_PREFIX=financial-toolbox/
# OCR stays disabled until its API has been activated and credentials are set.
FT_OCR_PROVIDER=disabled
FT_OCR_SECRET_ID=
FT_OCR_SECRET_KEY=
FT_OCR_REGION=ap-guangzhou
FT_OCR_TIMEOUT_SECONDS=60

# Stage 3: export file access expiry. Physical cleanup is a separate policy.
FT_EXPORT_RETENTION_DAYS=7
# Optional readable, licensed Chinese TTF for embedded PDF fonts.
# FT_PDF_FONT_PATH=/path/to/chinese-font.ttf

# Stage 4: function-calling chat model. Configure the SAME settings for API and Worker.
FT_MODEL_PROVIDER=disabled
# Enable chat_completions only after choosing a provider supporting tools.
FT_MODEL_BASE_URL=
FT_MODEL_NAME=
FT_MODEL_API_KEY=
FT_MODEL_TIMEOUT_SECONDS=60
FT_MODEL_MAX_OUTPUT_TOKENS=2048
FT_AGENT_MAX_MODEL_CALLS=12
FT_AGENT_MAX_TOOL_CALLS=30
FT_AGENT_MAX_CONTEXT_CHARS=100000
FT_AGENT_MAX_TOTAL_TOKENS=100000
FT_AGENT_RUN_SECONDS=86400
FT_CHAT_ACTION_SECONDS=600
